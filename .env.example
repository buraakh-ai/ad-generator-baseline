# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

# ---------------------------------------------------------------------------
# OpenAI — the only LLM/image provider. Two text tiers: OPENAI_TEXT_MODEL
# (gpt-4o-mini) for short/low-risk generations (a headline, a numeric
# score); OPENAI_HIGH_END_TEXT_MODEL (gpt-5.5) for brand-sensitive/creative
# work — ad copy, company research, event selection, and the image
# poster-prompt writer. Images are a 3-tier fallback chain, best quality
# first: gpt-image-2.5-sunburst -> gpt-image-1 -> dall-e-3. The top two
# draw the whole poster (headline/bullets/CTA/icons) directly; dall-e-3 is
# last-resort only — it predates native text rendering.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_HIGH_END_TEXT_MODEL=gpt-5.5
# Provider list/order/enabled state for images lives in image_config.json,
# not here — these just supply the model ids.
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_FALLBACK_IMAGE_MODEL=gpt-image-1
OPENAI_LAST_RESORT_IMAGE_MODEL=dall-e-3

# ---------------------------------------------------------------------------
# AWS (S3 for generated images, Secrets Manager for social tokens + the
# OPENAI_API_KEY/Facebook/LinkedIn app-secrets overlay in a deployed
# environment — see core.config.Settings.refresh_from_aws_secrets). Leave
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY blank when running on AWS with an
# instance/task role that already has S3 + Secrets Manager permissions;
# boto3 falls back to that role automatically (tools/secrets_tool.py).
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
AWS_BUCKET_NAME=
BUSINESS_ID=your-business-id

# ---------------------------------------------------------------------------
# Brand assets — this business's real logo + CEO/team photo, composited
# onto every generated ad image (skills/image_compositing_skill.py). Public
# URLs only — e.g. a public-read object in AWS_BUCKET_NAME above, same
# convention tools/s3_tool.py already uses for generated images:
# https://<bucket>.s3.<region>.amazonaws.com/<key>. Leave blank to skip
# (falls back to the Clearbit-researched logo, no CEO card).
# ---------------------------------------------------------------------------
BRAND_LOGO_URL=
BRAND_CEO_PHOTO_URL=
BRAND_CEO_NAME=
BRAND_CEO_TITLE=
# A generated image can't actually be clickable — when set, this URL is
# printed as small plain text near the bottom instead of a fake CTA button.
BRAND_CONTACT_URL=

# ---------------------------------------------------------------------------
# Facebook
# ---------------------------------------------------------------------------
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---------------------------------------------------------------------------
# Instagram
# ---------------------------------------------------------------------------
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_REFRESH_AFTER_DAYS=50

# ---------------------------------------------------------------------------
# LinkedIn
# ---------------------------------------------------------------------------
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_TOKEN_ISSUED_AT=2026-01-01
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_OAUTH_REDIRECT_URI=http://localhost:8000
LINKEDIN_TOKEN_LIFETIME_DAYS=60
LINKEDIN_EXPIRY_WARNING_DAYS=10
LINKEDIN_API_VERSION=202601

# ---------------------------------------------------------------------------
# Paid ad management (Meta Marketing API + LinkedIn Marketing API) — see
# tools/facebook_ads_tool.py / tools/linkedin_ads_tool.py. Distinct from the
# organic-posting credentials above: both need a separate, more selective
# API product/app-review approval than plain posting (Meta's
# ads_management permission; LinkedIn's Marketing Developer Platform
# product + rw_ads scope). Every campaign this app creates is forced to
# PAUSED (Meta) / DRAFT (LinkedIn) regardless of these settings —
# activating one (spending real budget) is always a separate, explicit
# action in the UI. Leave blank to hide/skip this feature.
# ---------------------------------------------------------------------------
FACEBOOK_AD_ACCOUNT_ID=
# Falls back to FACEBOOK_PAGE_TOKEN above if left blank — only works if
# that token also happens to carry ads_management; set this explicitly
# once you have a token scoped for the Marketing API (e.g. a Business
# Manager System User token).
FACEBOOK_MARKETING_ACCESS_TOKEN=
FACEBOOK_AD_CURRENCY=USD

LINKEDIN_AD_ACCOUNT_ID=
# Falls back to LINKEDIN_ACCESS_TOKEN above if left blank — that token is
# posting-only (w_member_social) and will NOT work for ads; set this once
# you have a token with rw_ads scope from the Marketing Developer Platform.
LINKEDIN_MARKETING_ACCESS_TOKEN=
LINKEDIN_AD_CURRENCY=USD

# Read by the frontend directly (not the backend) — shows/hides the "Paid
# promotion" panel in the Ad generator module's Image & publish tab.
# Leave false until the settings above are actually configured.
ENABLE_PAID_PROMOTION=false

# Also frontend-only — prefills the Ad generator's Generate form with the
# business this deployment is for, so the common case is just hitting
# Generate. All three stay editable in the UI; blank means an empty field.
DEFAULT_COMPANY_URL=
DEFAULT_COMPANY_NAME=
DEFAULT_CONTACT_URL=

# Required to actually activate a draft campaign (the one action that
# spends real money) — checked server-side in backend/main.py, so it
# can't be bypassed by calling the API directly. Blank = activation is
# blocked entirely, even with the panel enabled above.
CAMPAIGN_EXECUTION_PASSWORD=

# ---------------------------------------------------------------------------
# Loop-safety — every retry/fallback loop in the project is bounded by one
# of these instead of a hardcoded number.
# ---------------------------------------------------------------------------
MAX_LLM_ATTEMPTS=3
MAX_IMAGE_ATTEMPTS=3
MAX_MEDIA_POLL_ATTEMPTS=10

# ---------------------------------------------------------------------------
# Backend / frontend wiring
# ---------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_BASE_URL=http://localhost:8000
# Per-module backend URL for the frontend's Ad generator module
# (frontend/app_pages/ad_generator.py) — falls back to BACKEND_BASE_URL
# above if unset, so this only needs setting once you're running multiple
# backend containers (one per module) and BACKEND_BASE_URL no longer
# unambiguously means "the Ad generator backend".
AD_GENERATOR_BACKEND_URL=
# Comma-separated browser origins allowed to call the backend directly.
# Leave blank to allow all ("*") — fine for this credential-less API.
CORS_ALLOW_ORIGINS=

DEBUG=false
